---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import Comments from "../components/Comments.astro";
import FormattedDate from "../components/FormattedDate.astro";
import PostNav, { type PostNavLink } from "../components/PostNav.astro";
import Toc from "../components/Toc.astro";
import { AUTHOR_NAME, SITE_URL } from "../consts";
import type { AnyEntry } from "../lib/content";

interface Props {
  entry: AnyEntry;
  collection: "blog" | "knowledge";
  headings?: MarkdownHeading[];
  /** 같은 컬렉션의 더 오래된 글 (이전 글, ←) */
  prev?: PostNavLink;
  /** 같은 컬렉션의 더 최신 글 (다음 글, →) */
  next?: PostNavLink;
}

const { entry, collection, headings = [], prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = entry.data;
const category = "category" in entry.data ? entry.data.category : undefined;

const pagePath = `/${collection}/${entry.id}/`;
const mdPath = `/${collection}/${entry.id}.md`;
const ogImage = `/og/${collection}/${entry.id}.png`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: {
    "@type": "Person",
    name: AUTHOR_NAME,
    url: SITE_URL,
  },
  url: new URL(pagePath, SITE_URL).href,
  mainEntityOfPage: new URL(pagePath, SITE_URL).href,
  image: new URL(ogImage, SITE_URL).href,
  inLanguage: "ko",
  ...(tags.length > 0 && { keywords: tags.join(", ") }),
  ...(category && { articleSection: category }),
};
---

<BaseLayout {title} {description} {ogImage} type="article" {jsonLd}>
  <link
    slot="head"
    rel="alternate"
    type="text/markdown"
    title={`${title} (Markdown)`}
    href={new URL(mdPath, SITE_URL).href}
  />

  <article>
    <header class="mb-10">
      {
        category && (
          <p class="mb-2 text-sm font-medium text-accent">{category}</p>
        )
      }
      <h1 class="text-3xl leading-tight font-bold tracking-tight">{title}</h1>
      <div
        class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-neutral-500 dark:text-neutral-400"
      >
        <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <span>
              (수정: <FormattedDate date={updatedDate} />)
            </span>
          )
        }
        {
          tags.length > 0 && (
            <ul class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li class="before:text-neutral-400 before:content-['#']">
                  {tag}
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </header>

    <Toc {headings} />

    <div
      class="prose prose-neutral dark:prose-invert max-w-none prose-headings:tracking-tight prose-a:text-accent prose-a:decoration-accent/40 prose-a:underline-offset-4 hover:prose-a:decoration-accent"
    >
      <slot />
    </div>
  </article>

  <PostNav {prev} {next} />

  <Comments />
</BaseLayout>

<style>
  /* TOC 앵커 이동 시 헤딩이 뷰포트 상단에 딱 붙지 않도록 여유를 준다.
     (부드러운 스크롤 자체는 global.css의 html { scroll-behavior: smooth }) */
  .prose :global(:is(h2, h3, h4)) {
    scroll-margin-top: 1.5rem;
  }
</style>
