---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import PostThumb from "../../components/PostThumb.astro";
import { getPublishedBlog } from "../../lib/content";

const posts = await getPublishedBlog();
---

<BaseLayout
  title="블로그"
  description="고영준의 블로그 글 목록. 생각과 경험을 기록합니다."
>
  <h1 class="mb-10 text-3xl font-bold tracking-tight">블로그</h1>

  {
    posts.length === 0 ? (
      <p class="text-neutral-500">아직 글이 없습니다.</p>
    ) : (
      <ul class="divide-y divide-neutral-200 dark:divide-neutral-800">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="group block py-6">
              <article class="flex items-start gap-5">
                <div class="min-w-0 flex-[7]">
                  <h2 class="text-lg font-semibold tracking-tight group-hover:text-accent">
                    {post.data.title}
                  </h2>
                  <p class="mt-2 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
                    {post.data.description}
                  </p>
                  <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-neutral-500 dark:text-neutral-500">
                    <FormattedDate date={post.data.pubDate} />
                    {post.data.tags.length > 0 && (
                      <span>{post.data.tags.map((t) => `#${t}`).join(" ")}</span>
                    )}
                  </p>
                </div>
                <PostThumb entry={post} />
              </article>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
