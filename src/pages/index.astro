---
import BaseLayout from "../layouts/BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import PostThumb from "../components/PostThumb.astro";
import { getPublishedBlog, getPublishedKnowledge } from "../lib/content";
import { AUTHOR_NAME, SITE_URL, SITE_DESCRIPTION, GITHUB_URL } from "../consts";

const recentPosts = (await getPublishedBlog()).slice(0, 3);
const recentNotes = (await getPublishedKnowledge()).slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: AUTHOR_NAME,
  url: SITE_URL,
  sameAs: [GITHUB_URL],
  description: SITE_DESCRIPTION,
};
---

<BaseLayout {jsonLd}>
  <section class="mb-16">
    <h1 class="text-3xl font-bold tracking-tight">고영준</h1>
    <div class="mt-6 space-y-4 leading-relaxed text-neutral-700 dark:text-neutral-300">
      <p>
        기획하고 직접 만드는 사람, 고영준입니다. 프론트엔드 엔지니어로 시작해
        지금은 케어링에서 장기요양 도메인의 PM으로 일하며, 고객과 데이터,
        법·제도를 분석해 진짜 문제를 정의하고 팀과 함께 제품으로 풀어냅니다.
      </p>
      <p>
        문제를 먼저 정의하고, 만든 것이 실제로 쓰일 때를 성과로 삼습니다.
        결정은 문서로, 배움은 회고로 남깁니다. 기획과 개발을 오가며 만든
        것들과 그 과정의 판단을 이 블로그에 기록합니다.
      </p>
      <p class="flex flex-wrap gap-x-5 text-sm">
        <a href="/about/" class="text-accent hover:underline"
          >소개 보기 &rarr;</a
        >
        <a href="/resume/" class="text-accent hover:underline"
          >이력서 보기 &rarr;</a
        >
      </p>
    </div>
  </section>

  <section class="mb-16">
    <div class="mb-4 flex items-baseline justify-between border-b border-neutral-200 pb-3 dark:border-neutral-800">
      <h2 class="text-lg font-semibold tracking-tight">최근 글</h2>
      <a href="/blog" class="text-sm text-accent hover:underline">전체 보기</a>
    </div>
    {
      recentPosts.length === 0 ? (
        <p class="text-sm text-neutral-500">아직 글이 없습니다.</p>
      ) : (
        <ul class="space-y-5">
          {recentPosts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`} class="group flex items-start gap-5">
                <div class="min-w-0 flex-[7]">
                  <h3 class="font-medium group-hover:text-accent">
                    {post.data.title}
                  </h3>
                  <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
                    <FormattedDate date={post.data.pubDate} /> ·{" "}
                    {post.data.description}
                  </p>
                  {post.data.tags.length > 0 && (
                    <p class="mt-1.5 text-xs text-neutral-500 dark:text-neutral-500">
                      {post.data.tags.map((t) => `#${t}`).join(" ")}
                    </p>
                  )}
                </div>
                <PostThumb entry={post} />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section>
    <div class="mb-4 flex items-baseline justify-between border-b border-neutral-200 pb-3 dark:border-neutral-800">
      <h2 class="text-lg font-semibold tracking-tight">최근 지식 노트</h2>
      <a href="/knowledge" class="text-sm text-accent hover:underline"
        >전체 보기</a
      >
    </div>
    {
      recentNotes.length === 0 ? (
        <p class="text-sm text-neutral-500">아직 노트가 없습니다.</p>
      ) : (
        <ul class="space-y-5">
          {recentNotes.map((note) => (
            <li>
              <a
                href={`/knowledge/${note.id}/`}
                class="group flex items-start gap-5"
              >
                <div class="min-w-0 flex-[7]">
                  <h3 class="font-medium group-hover:text-accent">
                    <span class="mr-2 text-sm font-normal text-accent">
                      {note.data.category}
                    </span>
                    {note.data.title}
                  </h3>
                  <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
                    <FormattedDate date={note.data.pubDate} /> ·{" "}
                    {note.data.description}
                  </p>
                  {note.data.tags.length > 0 && (
                    <p class="mt-1.5 text-xs text-neutral-500 dark:text-neutral-500">
                      {note.data.tags.map((t) => `#${t}`).join(" ")}
                    </p>
                  )}
                </div>
                <PostThumb entry={note} />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
