---
import { render } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";
import { getPublishedKnowledge } from "../../lib/content";

export async function getStaticPaths() {
  // 카테고리 무관 전체 발행일 최신순(desc) 기준: [i-1] = 다음(최신), [i+1] = 이전(과거)
  const notes = await getPublishedKnowledge();
  return notes.map((note, i) => {
    const newer = notes[i - 1];
    const older = notes[i + 1];
    return {
      params: { slug: note.id },
      props: {
        entry: note,
        prev: older && {
          title: older.data.title,
          href: `/knowledge/${older.id}/`,
        },
        next: newer && {
          title: newer.data.title,
          href: `/knowledge/${newer.id}/`,
        },
      },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<PostLayout {entry} {headings} {prev} {next} collection="knowledge">
  <Content />
</PostLayout>
