---
import { getHeroImage, type AnyEntry } from "../lib/content";

/**
 * 목록용 대표 이미지 썸네일. heroImage → OG 카드 폴백은 getHeroImage가 담당.
 * 순수 정적 img — lazy 로딩 유지.
 *
 * 카드 레이아웃 계약: 부모가 flex row(본문 flex-[7])일 때 래퍼가
 * 가로 30%(flex-[3])를 차지하고, self-stretch로 카드 높이 100%를 채운다.
 * img는 absolute fill(h-full + object-cover)이라 카드 높이에 관여하지 않는다
 * — 카드 높이는 항상 본문 텍스트가 결정하고, 이미지가 따라 늘어난다.
 * CLS 방지: 폭은 flex 비율, 높이는 텍스트 열이 결정하므로 이미지 로드
 * 전후 레이아웃이 동일하다. width/height는 intrinsic 힌트로 유지.
 */
interface Props {
  entry: AnyEntry;
}

const { entry } = Astro.props;
const src = getHeroImage(entry);
---

<div
  class="relative min-w-0 flex-[3] self-stretch overflow-hidden rounded-md border border-neutral-200 bg-white dark:border-neutral-800"
>
  <img
    src={src}
    alt=""
    width="160"
    height="90"
    loading="lazy"
    class="absolute inset-0 h-full w-full object-cover"
  />
</div>
