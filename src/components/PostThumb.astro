---
import { getHeroImage, type AnyEntry } from "../lib/content";

/**
 * 목록용 대표 이미지 썸네일. heroImage → OG 카드 폴백은 getHeroImage가 담당.
 * 순수 정적 img — lazy 로딩 + width/height 지정으로 CLS 방지.
 */
interface Props {
  entry: AnyEntry;
}

const { entry } = Astro.props;
const src = getHeroImage(entry);
---

<img
  src={src}
  alt=""
  width="160"
  height="90"
  loading="lazy"
  class="mt-1 aspect-video w-28 shrink-0 rounded-md border border-neutral-200 bg-white object-cover sm:w-36 dark:border-neutral-800"
/>
