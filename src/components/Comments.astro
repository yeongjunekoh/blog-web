---
// giscus 댓글 + 리액션 (GitHub Discussions 기반, 카테고리: Announcements).
// repo-id / category-id는 GraphQL로 조회한 값을 하드코딩한 것.
// React 패키지 대신 공식 script 임베드를 쓴다 (본문은 여전히 정적 HTML로 유지).
---

<section
  id="comments"
  aria-label="댓글"
  class="mt-16 border-t border-neutral-200 pt-8 dark:border-neutral-800"
>
  <h2 class="sr-only">댓글</h2>
  <script is:inline>
    (() => {
      // BaseLayout head의 FOUC 방지 스크립트가 이미 html.dark를 세팅해둔 상태라
      // 여기서 클래스를 읽으면 초기 테마가 정확하다.
      const theme = document.documentElement.classList.contains("dark")
        ? "dark"
        : "light";
      const script = document.createElement("script");
      script.src = "https://giscus.app/client.js";
      script.async = true;
      script.crossOrigin = "anonymous";
      const attrs = {
        "data-repo": "yeongjunekoh/blog-web",
        "data-repo-id": "R_kgDOTgEpAw",
        "data-category": "Announcements",
        "data-category-id": "DIC_kwDOTgEpA84DCINt",
        "data-mapping": "pathname",
        "data-strict": "1",
        "data-reactions-enabled": "1",
        "data-emit-metadata": "0",
        "data-input-position": "top",
        "data-theme": theme,
        "data-lang": "ko",
        "data-loading": "lazy",
      };
      for (const [key, value] of Object.entries(attrs)) {
        script.setAttribute(key, value);
      }
      document.getElementById("comments")?.appendChild(script);
    })();
  </script>
</section>
